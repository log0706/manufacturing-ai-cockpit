# Dependencies and generated output
node_modules/
dist/
coverage/

# Netlify / local deployment state
.netlify/

# Environment files. Keep the documented template public-safe.
.env
.env.*
!.env.example

# Local logs and transient dev artifacts
*.log
npm-debug.log*
vite-dev.log
vite-dev.err.log
preview-*.log
.playwright-cli/

# Internal audit / orchestration material that should not be published.
# These patterns are anchored to the repository root on purpose: an unanchored
# `audit/` also matches `docs/audit/`, which silently excluded published audit
# evidence from commits.
AGENTS.md
/audit/
/reports/
